NEXT_PUBLIC_SUPABASE_URL=
# Prefer the current publishable key. The legacy anon key is supported for migration.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required only for explicit Auth Admin actions (create/update users).
SUPABASE_SERVICE_ROLE_KEY=
# Server-only credential used by the notification service.
RESEND_API_KEY=
# Canonical public origin used in email links. Until the custom domain is ready,
# use the current production deployment, for example https://sdnexops.vercel.app.
NEXT_PUBLIC_APP_URL=https://soporte.nexopstech.com
