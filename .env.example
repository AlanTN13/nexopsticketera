NEXT_PUBLIC_SUPABASE_URL=
# Prefer the current publishable key. The legacy anon key is supported for migration.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required only for explicit Auth Admin actions (create/update users).
SUPABASE_SERVICE_ROLE_KEY=
# Server-only credential used by the notification service.
RESEND_API_KEY=
# Canonical public origin used in email links. The Vercel production URL remains
# a supported fallback for temporary or preview environments.
NEXT_PUBLIC_APP_URL=https://portal.nexopstech.com
# Enable only after the canonical domain has valid DNS, SSL, and Supabase Auth redirects.
PORTAL_CANONICAL_REDIRECT_ENABLED=false

# Server-only Google Sheets sources used by /portal/metricas. Never expose these
# values through NEXT_PUBLIC_* variables or browser-editable settings.
PORTAL_METRICS_META_SHEET_URL=
PORTAL_METRICS_MAILCHIMP_SHEET_URL=

# Optional reportería profile override keyed by company slug. Product availability
# is managed in Supabase from Backoffice and is not controlled by this variable.
# {"global-trip":{"accountName":"GLOBAL TRIP","objective":"CONVERSACIONES"}}
PORTAL_METRICS_COMPANY_CONFIG=

# Radar sources are read only on the server. The public manifest contains only
# published business data; the private token should have Contents: read access
# only to the configured history repository.
# Platform workspace shown only to the active platform administrator (the
# mother NexOps account). It is independent from every client/test company.
RADAR_PLATFORM_WORKSPACE_ID=
# Optional read-only presentation preferences for the platform workspace.
RADAR_PLATFORM_PREFERENCES={}
RADAR_PUBLICATIONS_URL=https://www.nexopstech.com/radar-publications.json
RADAR_HISTORY_REPOSITORY=AlanTN13/radar-history
RADAR_HISTORY_BRANCH=history
RADAR_HISTORY_READ_TOKEN=

# Server-only bridge from Portal to the existing webneoxps engine. The callback
# secret is shared only by both servers. Publication remains disabled in V1.
RADAR_ENGINE_GITHUB_REPOSITORY=AlanTN13/webneoxps
RADAR_ENGINE_GITHUB_TOKEN=
RADAR_ENGINE_CALLBACK_SECRET=
